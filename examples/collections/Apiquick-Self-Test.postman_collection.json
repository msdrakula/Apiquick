    {
      "name": "CRUD collections & requests",
      "item": [
        {
          "name": "Create collection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/collections",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apiquick CRUD Temp\",\n  \"description\": \"created by self-test collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename collection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/collections/{{colId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apiquick CRUD Temp renamed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate collection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/collections/{{colId}}/duplicate"
          }
        },
        {
          "name": "Export collection",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/collections/{{colId}}/export"
          }
        },
        {
          "name": "Create request in collection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"collection_id\": \"{{colId}}\",\n  \"name\": \"Ping health\",\n  \"method\": \"GET\",\n  \"url\": \"http://127.0.0.1:8765/health\",\n  \"headers\": [],\n  \"params\": [],\n  \"body_type\": \"none\",\n  \"body_content\": \"\",\n  \"body_raw_type\": \"json\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get request by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests/{{reqId}}"
          }
        },
        {
          "name": "Update request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/requests/{{reqId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ping health updated\",\n  \"method\": \"GET\",\n  \"url\": \"http://127.0.0.1:8765/health\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List requests in collection",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests/collection/{{colId}}"
          }
        },
        {
          "name": "Delete request",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/requests/{{reqId}}"
          }
        },
        {
          "name": "Delete collection",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/collections/{{colId}}"
          }
        }
